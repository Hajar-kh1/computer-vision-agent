# ── Python / uv ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
uv.lock.tmp

# ── Env & secrets (spec §34: keep secrets outside Git) ──────────────────────
.env
.env.*
!.env.example

# ── Data & model artifacts (too large / regenerable) ────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
models/*.pt
models/*.onnx
!models/.gitkeep
training/runs/
reports/

# ── Frontend / Node ──────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# ── Docker / deployment ──────────────────────────────────────────────────────
docker-compose.override.yml

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
