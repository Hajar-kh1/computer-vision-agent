# ── Package Damage Detection — environment template ────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
# Inside Docker Compose, these are also read from `environment:` blocks
# in compose.yaml (spec §28, §29).

# PostgreSQL connection string (Docker service name in compose):
# postgresql+psycopg://cvuser:cvpassword@postgres:5432/cvapp
DATABASE_URL=

# LLM provider (Open WebUI / agent tool calling)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Model artifact
MODEL_PATH=/app/models/model.pt
MODEL_VERSION=1.0.0

# CORS (comma-separated origins; local dev: http://localhost:5173,http://localhost:3000)
CORS_ORIGINS=

# Max upload size in MB (security: limit oversized uploads)
MAX_UPLOAD_MB=10

# Production hardening
DEBUG=false
